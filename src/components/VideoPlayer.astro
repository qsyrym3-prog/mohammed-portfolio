---
// Lightweight video: shows a poster image, and only loads the YouTube/Vimeo player
// after the visitor clicks. No link yet → "coming soon" poster.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { youtubeId, vimeoId } from '../lib/projects';

interface Props {
  youtube?: string;
  vimeo?: string;
  poster: ImageMetadata;
  title: string;
  playLabel: string;
  comingSoonLabel: string;
}
const { youtube = '', vimeo = '', poster, title, playLabel, comingSoonLabel } = Astro.props;
const yt = youtubeId(youtube);
const vm = !yt ? vimeoId(vimeo) : null;
const embed = yt
  ? `https://www.youtube-nocookie.com/embed/${yt}?autoplay=1&rel=0&modestbranding=1&playsinline=1`
  : vm
    ? `https://player.vimeo.com/video/${vm}?autoplay=1&dnt=1`
    : null;
---

<div class="video-player relative aspect-video w-full overflow-hidden rounded-[2px] bg-ink">
  <Picture src={poster} formats={['avif', 'webp']} widths={[640, 1000, 1600]} sizes="(min-width: 1280px) 76rem, 100vw" alt="" class="absolute inset-0 h-full w-full object-cover" />
  {embed ? (
    <button type="button" class="video-play group absolute inset-0 grid place-items-center bg-ink/25 transition-colors hover:bg-ink/35" data-embed={embed} data-title={title} aria-label={`${playLabel}: ${title}`}>
      <span class="grid h-20 w-20 place-items-center rounded-full bg-terra text-on-terra shadow-xl transition-transform duration-500 group-hover:scale-105 md:h-24 md:w-24">
        <Icon name="play" size={34} class="ms-1" />
      </span>
    </button>
  ) : (
    <div class="absolute inset-0 grid place-items-center bg-ink/55">
      <div class="text-center text-cream">
        <span class="mx-auto grid h-16 w-16 place-items-center rounded-full border border-cream/40"><Icon name="video" size={26} /></span>
        <p class="mt-4 text-xl font-medium md:text-2xl">{comingSoonLabel}</p>
        <p class="serif mt-1 text-lg italic text-cream/70" lang="en">Coming soon</p>
      </div>
    </div>
  )}
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.video-play').forEach((btn) =>
    btn.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = btn.dataset.embed!;
      iframe.title = btn.dataset.title || 'Video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 h-full w-full border-0';
      btn.parentElement!.appendChild(iframe);
      btn.remove();
      iframe.focus();
    }),
  );
</script>
