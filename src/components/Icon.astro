  )}
  {name === 'mail' && (<><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 6.5 8.5 6.5 8.5-6.5" /></>)}
  {name === 'phone' && (<path d="M5 3.5h3.2l1.6 4.2-2.1 1.3a11 11 0 0 0 5.3 5.3l1.3-2.1 4.2 1.6V17a2 2 0 0 1-2.2 2A15.5 15.5 0 0 1 3 5.7 2 2 0 0 1 5 3.5Z" />)}
  {name === 'instagram' && (<><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4.2" /><circle cx="17.4" cy="6.6" r="0.9" fill="currentColor" stroke="none" /></>)}
  {name === 'tiktok' && (<path d="M14.5 3v11.3a3.7 3.7 0 1 1-3.2-3.66M14.5 3c.4 2.6 2.2 4.4 5 4.6" />)}
  {name === 'arrow' && (<path d="M5 12h14m-6-6 6 6-6 6" />)}
  {name === 'chevron' && (<path d="m9 6 6 6-6 6" />)}
  {name === 'play' && (<path fill="currentColor" stroke="none" d="M8 5.5v13a1 1 0 0 0 1.5.86l10.6-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z" />)}
  {name === 'menu' && (<path d="M4 8h16M4 16h16" />)}
  {name === 'close' && (<path d="M6 6l12 12M18 6 6 18" />)}
