---
import Icon from '../Icon.astro';
import { t, type Lang } from '../../i18n/site';
import { pad2 } from '../../lib/projects';
interface Props { lang: Lang }
const s = t[Astro.props.lang];
const icons = ['camera', 'event', 'sports', 'video'] as const;
---

<section id="services" class="grain bg-sand py-24 md:py-32" aria-labelledby="services-title">
  <div class="container-x">
    <p class="eyebrow reveal">{s.services.eyebrow}</p>
    <h2 id="services-title" class="display reveal mt-3 text-[clamp(3rem,10vw,7rem)]" style="--delay:80ms">{s.services.title}</h2>

    <ul class="mt-14 grid gap-5 sm:grid-cols-2 md:mt-20 lg:grid-cols-4">
      {s.services.items.map((it, i) => (
        <li class="reveal group flex flex-col rounded-[2px] bg-card p-7 transition-[transform,box-shadow] duration-500 hover:-translate-y-1 hover:shadow-[0_24px_50px_-28px_rgb(31_26_22/0.35)] md:p-8" style={`--delay:${i * 90}ms`}>
          <div class="flex items-center justify-between">
            <span class="num text-5xl leading-none">{pad2(i + 1)}</span>
            <span class="grid h-12 w-12 place-items-center rounded-full border border-line text-terra transition-colors group-hover:border-terra group-hover:bg-terra group-hover:text-on-terra">
              <Icon name={icons[i]} size={22} />
            </span>
          </div>
          <h3 class="mt-10 text-xl font-medium md:text-[1.35rem]">{it.title}</h3>
          <p class="mt-3 leading-[1.85] text-muted">{it.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
